{% set fnox_profile = vars.fnox_profile -%}
{% set hermes_telegram_bot_token = exec(command='$HOME/.local/share/mise/shims/fnox --config "$HOME/src/dotfiles/cli/fnox/config.toml" --non-interactive -P ' ~ fnox_profile ~ ' get TELEGRAM_BOT_TOKEN 2>/dev/null || true') | trim -%}
{% set hermes_telegram_allowed_users = exec(command='$HOME/.local/share/mise/shims/fnox --config "$HOME/src/dotfiles/cli/fnox/config.toml" --non-interactive -P ' ~ fnox_profile ~ ' get TELEGRAM_ALLOWED_USERS 2>/dev/null || true') | trim -%}
{% set hermes_telegram_home_channel = exec(command='$HOME/.local/share/mise/shims/fnox --config "$HOME/src/dotfiles/cli/fnox/config.toml" --non-interactive -P ' ~ fnox_profile ~ ' get TELEGRAM_HOME_CHANNEL 2>/dev/null || true') | trim -%}
{% if hermes_telegram_bot_token != "" -%}
TELEGRAM_BOT_TOKEN={{ hermes_telegram_bot_token }}
{% endif -%}
{% if hermes_telegram_allowed_users != "" -%}
TELEGRAM_ALLOWED_USERS={{ hermes_telegram_allowed_users }}
{% endif -%}
{% if hermes_telegram_home_channel != "" -%}
TELEGRAM_HOME_CHANNEL={{ hermes_telegram_home_channel }}
{% endif -%}