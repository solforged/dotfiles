{% set fnox = '$HOME/.local/share/mise/shims/fnox --non-interactive --no-defaults -P ' ~ vars.fnox_profile -%}
{% else -%}
{% set fnox = '$HOME/.local/share/mise/shims/fnox --non-interactive -P ' ~ vars.fnox_profile -%}
{% endif -%}
{{ exec(command=fnox ~ ' get GITLEAKS_CONFIG_TOML 2>/dev/null || true') | trim }}
