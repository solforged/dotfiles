{% set github_key = vars.github_key | default(value="") -%}
Host github.com
  HostName github.com
  User git
{%- if github_key != "" %}
  IdentityFile {{ github_key }}
  IdentitiesOnly yes
  IdentityAgent none
{%- else %}
{%- if vars.onepassword_agent_sock != "" %}
  IdentityAgent "{{ vars.onepassword_agent_sock }}"
{%- endif %}
  IdentitiesOnly no
  AddKeysToAgent yes
{%- endif %}
  IgnoreUnknown UseKeychain
  ServerAliveInterval 60
  ServerAliveCountMax 3

Host sigil
  HostName sigil
  User admin
{% if vars.onepassword_agent_sock != "" -%}
  IdentityAgent "{{ vars.onepassword_agent_sock }}"
{% endif -%}
  IdentitiesOnly no
  ForwardAgent yes

Host amarna
  HostName amarna
  User sol
{% if vars.onepassword_agent_sock != "" -%}
  IdentityAgent "{{ vars.onepassword_agent_sock }}"
{% endif -%}
  IdentitiesOnly no
  ForwardAgent no

Host agent-vm
  HostName agent-vm
  User vmadmin
{%- if vars.onepassword_agent_sock != "" %}
  IdentityAgent "{{ vars.onepassword_agent_sock }}"
{%- endif %}
  IdentitiesOnly no
  ForwardAgent yes

{% if vars.ssh_auth_sock != "" -%}
Host *
  IdentityAgent "{{ vars.ssh_auth_sock }}"
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  HashKnownHosts yes
{% else -%}
Host *
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  HashKnownHosts yes
{% endif -%}
