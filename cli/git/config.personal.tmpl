[user]
  name = {{ vars.git_user_name }}
  email = {{ vars.git_user_email }}
{% if vars.git_signing_key != "" -%}
  signingkey = {{ vars.git_signing_key }}
{% endif -%}

[gpg]
  format = ssh

{% if vars.git_signing_program != "" -%}
[gpg "ssh"]
  program = {{ vars.git_signing_program }}
{% endif -%}
{% if vars.git_signing_key != "" -%}
  allowedSignersFile = ~/.config/git/allowed_signers
{% endif -%}

[commit]
  gpgsign = {% if vars.git_signing_key != "" %}true{% else %}false{% endif %}

[tag]
  gpgsign = {% if vars.git_signing_key != "" %}true{% else %}false{% endif %}
