{% set host = exec(command='(hostname -s 2>/dev/null || hostname 2>/dev/null || true) | tr "[:upper:]" "[:lower:]"') | trim -%}
# Generated from dotfiles for host: {{ host }}
auto_env = true
{% if host == "hyperion" -%}
env = ["base", "personal", "hyperion"]
{% elif host == "sigil" -%}
env = ["base", "personal", "sigil"]
{% elif host == "atlas" -%}
env = ["base", "atlas"]
{% elif host == "amarna" -%}
env = ["base", "personal", "amarna"]
{% else -%}
env = ["base", "personal"]
{% endif -%}
