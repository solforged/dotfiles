{% set host = exec(command='(hostname -s 2>/dev/null || hostname 2>/dev/null || true) | tr "[:upper:]" "[:lower:]"') | trim -%}
{#- The only host-to-module map: bootstrap renders this file before its
    first run. Later names override earlier ones; keep the host file last. -#}
{% set personal = ["base", "personal", "omp", "pi", "claude"] -%}
{% if host == "hyperion" -%}
{% set modules = personal | concat(with=["beets", "hyperion"]) -%}
{% elif host == "amarna" -%}
{% set modules = personal | concat(with=["beets", "amarna"]) -%}
{% elif host == "atlas" -%}
{% set modules = ["base", "atlas"] -%}
{% else -%}
{% set modules = personal -%}
{% endif -%}
# Generated from dotfiles for host: {{ host }}
auto_env = true
env = {{ modules | json_encode() }}
